<?xml version="1.0" encoding="utf-8"?>
<!--
    The Hermes dashboard is an HTTP server that runs *inside* the PRoot guest
    and listens on loopback only. Everything else must stay HTTPS: Android 9+
    blocks cleartext by default, and this config keeps it that way.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
